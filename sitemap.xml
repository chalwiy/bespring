---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages_sorted = site.html_pages | sort: "url" %}
{% for p in pages_sorted %}
  {% assign body = p.content | downcase %}
  {% assign page_path = p.path | downcase %}
  {% assign skip_page = false %}
  {% if page_path == "404.html" or page_path contains "/404.html" %}
    {% assign skip_page = true %}
  {% endif %}
  {% if body contains "noindex" %}
    {% assign skip_page = true %}
  {% endif %}
  {% if body contains 'http-equiv="refresh"' or body contains "http-equiv='refresh'" %}
    {% assign skip_page = true %}
  {% endif %}
  {% unless skip_page %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endunless %}
{% endfor %}
</urlset>
